import java.util.*;
import java.lang.*;
import java.io.*;

class GraphTraversal
{
    public void dfs(int node, List<List<Integer>> graph,boolean[] visited) {
        visited[node] = true; 
        System.out.println(node);
        
        for(int currentNode : graph.get(node)){
           if(!visited[currentNode]){
           dfs( currentNode,  graph, visited);
           }
            
        }
    }
    
    public void bfs(int node,Queue<Integer> queue,List<List<Integer>> graph,boolean[] visited) {
           
    visited[node] = true;
    System.out.println(node);

    for (int neighbor : graph.get(node)) {
        if (!visited[neighbor]) {
            queue.offer(neighbor);
        }
    }

    if (!queue.isEmpty()) {
        int value = queue.poll();
        bfs(value, queue, graph, visited);
    }
}
    
